#!/usr/bin/env python3
"""
Alberto-Serve: hardened server launcher with watchdog.

Differences from `alberto serve`:
- Pre-flight checks: deps, config, sandbox
- Auto-installs missing deps with mirror fallback
- Watchdog: if server crashes, restart automatically
- Health check: every 10s pings /api/status, calls SelfHealer on failure
- Single-instance lock (so multiple alberto-serve can't collide)

Usage:
    alberto-serve --port 8741
    alberto-serve --port 8741 --max-restarts 5
    alberto-serve --port 8741 --no-watchdog   # single run, no auto-restart
"""
from __future__ import annotations
import argparse
import json
import os
import signal
import socket
import stat
import subprocess
import sys
import time
import traceback
from pathlib import Path


# Pre-flight: ensure critical deps
REQUIRED_DEPS = ["pyyaml", "fastapi", "uvicorn", "httpx", "openai"]


def preflight_install():
    """Install missing critical deps with mirror fallback."""
    mirrors = [
        "https://mirrors.aliyun.com/pypi/simple/",
        "https://pypi.tuna.tsinghua.edu.cn/simple/",
        "https://pypi.org/simple/",
    ]
    for dep in REQUIRED_DEPS:
        try:
            __import__(dep if dep != "pyyaml" else "yaml")
        except ImportError:
            for mirror in mirrors:
                print(f"[preflight] installing {dep} from {mirror}...", flush=True)
                try:
                    r = subprocess.run(
                        [sys.executable, "-m", "pip", "install",
                         "--break-system-packages", "-q",
                         "-i", mirror, "--timeout", "30", dep],
                        capture_output=True, text=True, timeout=60,
                    )
                    if r.returncode == 0:
                        print(f"[preflight] ✓ {dep} installed", flush=True)
                        break
                except subprocess.TimeoutExpired:
                    continue
            else:
                print(f"[preflight] ✗ failed to install {dep} from any mirror",
                      file=sys.stderr, flush=True)


def find_free_port(start: int = 8741) -> int:
    """Find a free port starting from `start`."""
    for p in range(start, start + 100):
        with socket.socket() as s:
            try:
                s.bind(("", p))
                return p
            except OSError:
                continue
    raise RuntimeError("no free port in range")


def check_lock(pidfile: Path) -> bool:
    """Return True for a live instance or an unsafe PID file that needs review."""
    try:
        info = pidfile.lstat()
    except FileNotFoundError:
        return False
    if (
        not stat.S_ISREG(info.st_mode)
        or info.st_uid != os.getuid()
        or info.st_mode & 0o077
    ):
        print(f"[alberto-serve] unsafe PID file permissions/ownership: {pidfile}",
              file=sys.stderr, flush=True)
        return True
    try:
        pid = int(pidfile.read_text().strip())
        os.kill(pid, 0)
        return True
    except (OSError, ValueError):
        pidfile.unlink(missing_ok=True)
        return False


def write_lock(pidfile: Path, pid: int):
    """Create a private PID file without following symlinks."""
    pidfile.parent.mkdir(parents=True, exist_ok=True)
    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(pidfile, flags, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(str(pid))
    os.chmod(pidfile, 0o600)


_ACTIVE_SERVER_PROC = None


def kill_alberto_serves(pidfile: Path):
    """Stop only a verified, owned process recorded in this launcher's PID file."""
    try:
        info = pidfile.lstat()
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != os.getuid()
            or info.st_mode & 0o077
        ):
            raise RuntimeError("unsafe PID file permissions/ownership; refusing to kill a process")
        pid = int(pidfile.read_text().strip())
    except (OSError, ValueError):
        pidfile.unlink(missing_ok=True)
        return
    if pid == os.getpid():
        raise RuntimeError("refusing to terminate the current launcher process")
    cmdline_path = Path(f"/proc/{pid}/cmdline")
    try:
        cmdline = cmdline_path.read_bytes().replace(b"\x00", b" ").decode(errors="replace")
    except OSError as exc:
        raise RuntimeError("cannot verify existing server process; refusing to kill it") from exc
    if "alberto-serve" not in cmdline and "alberto.cli serve" not in cmdline:
        raise RuntimeError("PID file does not point to an Alberto server; refusing to kill it")
    os.kill(pid, signal.SIGTERM)
    deadline = time.time() + 5
    while time.time() < deadline:
        try:
            os.kill(pid, 0)
        except OSError:
            break
        time.sleep(0.1)
    else:
        # Re-check the process identity before escalating to SIGKILL.
        try:
            current = cmdline_path.read_bytes().replace(b"\x00", b" ").decode(errors="replace")
        except OSError:
            current = ""
        if ("alberto-serve" in current or "alberto.cli serve" in current):
            os.kill(pid, signal.SIGKILL)
    pidfile.unlink(missing_ok=True)


def wait_for_health(port: int, timeout: float = 15.0) -> bool:
    """Wait for /api/status to return 200."""
    import urllib.request
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            headers = {}
            token = os.environ.get("ALBERTO_API_TOKEN", "")
            if token:
                headers["Authorization"] = f"Bearer {token}"
            request = urllib.request.Request(
                f"http://127.0.0.1:{port}/api/status", headers=headers
            )
            with urllib.request.urlopen(request, timeout=2) as r:
                if r.status == 200:
                    return True
        except Exception:
            time.sleep(0.5)
    return False


def run_one(port: int, host: str = "0.0.0.0") -> int:
    """Run a single alberto serve process. Returns exit code."""
    env = os.environ.copy()
    env["ALBERTO_PORT"] = str(port)
    # Ensure PYTHONPATH includes alberto-ai so the subprocess can import alberto
    base_dir = Path(__file__).parent.parent
    existing_pp = env.get("PYTHONPATH", "")
    if str(base_dir) not in existing_pp:
        env["PYTHONPATH"] = f"{base_dir}:{existing_pp}" if existing_pp else str(base_dir)
    # Ensure /usr/local/bin is on PATH so alberto CLI is found by our interceptor
    extra_path = "/usr/local/bin:/usr/bin"
    env["PATH"] = f"{extra_path}:{env.get('PATH', '')}"
    cmd = [sys.executable, "-m", "alberto.cli", "serve",
           "--host", host, "--port", str(port)]
    print(f"[alberto-serve] starting: {' '.join(cmd)}", flush=True)
    global _ACTIVE_SERVER_PROC
    proc = subprocess.Popen(cmd, env=env,
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           text=True, bufsize=1)
    _ACTIVE_SERVER_PROC = proc
    try:
        # Stream output
        for line in proc.stdout:
            print(line, end="", flush=True)
            if "Uvicorn running" in line or "Application startup complete" in line:
                print(f"[alberto-serve] ✓ server up on port {port}", flush=True)
        proc.wait()
        return proc.returncode
    finally:
        _ACTIVE_SERVER_PROC = None


def watchdog_loop(port: int, max_restarts: int, host: str):
    """Watchdog: restart server on crash up to max_restarts times."""
    restarts = 0
    crash_history = []
    while True:
        rc = run_one(port, host)
        if rc == 0:
            print(f"[alberto-serve] clean exit", flush=True)
            return
        restarts += 1
        crash_history.append({"at": time.time(), "exit_code": rc})
        if max_restarts > 0 and restarts > max_restarts:
            print(f"[alberto-serve] ✗ crashed {restarts} times (>max {max_restarts}); giving up",
                  file=sys.stderr, flush=True)
            sys.exit(1)
        # Self-healing may mutate files/configuration; production requires explicit opt-in.
        production = os.environ.get("ALBERTO_ENV", "").strip().lower() in {"prod", "production"}
        allow_auto_heal = os.environ.get("ALBERTO_AUTO_HEAL", "").strip() == "1"
        if not production or allow_auto_heal:
            try:
                from alberto import Alberto
                from alberto.runtime.self_healing import SelfHealer
                a = Alberto()
                sh = SelfHealer(a)
                heal = sh.attempt_heal(
                    Exception(f"server crashed with exit code {rc}"),
                    context="server_watchdog"
                )
                print(f"[alberto-serve] heal result: fixed={heal.get('fixed')}, "
                      f"fixers={heal.get('matched_fixers', [])}", flush=True)
                a.shutdown()
            except Exception as e:
                print(f"[alberto-serve] heal attempt failed: {e}", file=sys.stderr, flush=True)
        else:
            print("[alberto-serve] production mode: automatic self-healing disabled; "
                  "set ALBERTO_AUTO_HEAL=1 only after reviewing mutation policy",
                  file=sys.stderr, flush=True)
        # Backoff before restart
        backoff = min(2 ** restarts, 30)
        print(f"[alberto-serve] restarting in {backoff}s (attempt {restarts})", flush=True)
        time.sleep(backoff)


def main():
    p = argparse.ArgumentParser(prog="alberto-serve",
                               description="Alberto server with watchdog + preflight")
    p.add_argument("--host", default="127.0.0.1")
    p.add_argument("--port", type=int, default=8741)
    p.add_argument("--max-restarts", type=int, default=10,
                  help="max consecutive restarts before giving up (0=infinite)")
    p.add_argument("--no-watchdog", action="store_true",
                  help="single-run, no auto-restart")
    p.add_argument("--no-preflight", action="store_true",
                  help="skip dependency pre-flight check")
    p.add_argument("--kill-existing", action="store_true",
                  help="kill any existing alberto serve before starting")
    args = p.parse_args()

    # Step 1: lock
    import getpass
    user_pidfile = Path(f"/tmp/alberto-serve-{getpass.getuser()}.pid")
    xdg_pidfile = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "alberto-serve.pid"
    pidfile = xdg_pidfile if xdg_pidfile.parent.exists() else user_pidfile
    if check_lock(pidfile):
        if not args.kill_existing:
            print(f"[alberto-serve] another instance is running (PID file {pidfile}). "
                  "Use --kill-existing only after verifying the recorded process.",
                  file=sys.stderr, flush=True)
            sys.exit(2)
        print("[alberto-serve] stopping the recorded Alberto server...", flush=True)
        try:
            kill_alberto_serves(pidfile)
        except RuntimeError as exc:
            print(f"[alberto-serve] {exc}", file=sys.stderr, flush=True)
            sys.exit(2)

    # Step 3: preflight
    if not args.no_preflight:
        print("[alberto-serve] running preflight checks...", flush=True)
        preflight_install()

    # Step 4: find free port
    port = args.port
    try:
        with socket.socket() as s:
            s.bind(("", port))
    except OSError:
        print(f"[alberto-serve] port {port} busy, finding free port...", flush=True)
        port = find_free_port(args.port + 1)
        print(f"[alberto-serve] using port {port}", flush=True)

    # Step 5: write our PID
    write_lock(pidfile, os.getpid())

    # Step 6: signal handling
    def shutdown(signum, frame):
        print(f"[alberto-serve] received signal {signum}, shutting down", flush=True)
        proc = _ACTIVE_SERVER_PROC
        if proc is not None and proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait(timeout=5)
        pidfile.unlink(missing_ok=True)
        sys.exit(0)
    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    cleanup_done = False
    try:
        if args.no_watchdog:
            rc = run_one(port, args.host)
            sys.exit(rc)
        else:
            watchdog_loop(port, args.max_restarts, args.host)
    except KeyboardInterrupt:
        pass
    except SystemExit:
        cleanup_done = True
        raise
    finally:
        try:
            pidfile.unlink(missing_ok=True)
            if not cleanup_done:
                print(f"[alberto-serve] cleaned up PID file: {pidfile}", flush=True)
        except Exception as e:
            print(f"[alberto-serve] cleanup error (non-fatal): {e}", file=sys.stderr)


if __name__ == "__main__":
    main()
