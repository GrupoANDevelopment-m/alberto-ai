#!/usr/bin/env python3
"""Alberto AI CLI entry point. Make executable and put on PATH."""
import sys
from pathlib import Path

# Ensure alberto package is importable when run from anywhere
HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from alberto.cli import main

if __name__ == "__main__":
    sys.exit(main())